# Copy to .env and adjust. Never commit .env.

# Optional: full path to ffmpeg. If empty, ffmpeg on PATH is used,
# then the copy bundled with the imageio-ffmpeg package.
FFMPEG_PATH=

# Optional: override where data is stored (relative to the project root).
RECORDINGS_DIR=recordings
REPORTS_DIR=reports
DB_PATH=data/speech_coach.db
