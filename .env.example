# Copy to .env and adjust. Never commit .env.
# On Streamlit Community Cloud, set these as secrets instead (see secrets.example.toml).

# true = cloud practice mode: lighter model, temp files deleted, no database.
CLOUD_MODE=false

# Optional: Whisper model and compute type.
# Defaults: local medium.en / auto, cloud small.en / int8.
WHISPER_MODEL=
WHISPER_COMPUTE_TYPE=

# Optional: full path to ffmpeg. If empty, ffmpeg on PATH is used,
# then the copy bundled with the imageio-ffmpeg package.
FFMPEG_PATH=

# Optional: override where data is stored (relative to the project root).
RECORDINGS_DIR=recordings
REPORTS_DIR=reports
DB_PATH=data/speech_coach.db
